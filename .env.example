# VetManager Mobile — Environment Configuration Template
# Copy this file to `.env` and adjust variables for your machine:
#   cp .env.example .env

# Backend REST API Base URL
# - Genymotion Android Emulator: http://10.0.3.2:8000/api/v1
# - Standard Android AVD Emulator: http://10.0.2.2:8000/api/v1
# - iOS Simulator / Web / Desktop: http://127.0.0.1:8000/api/v1
# - Physical Android/iOS Device (Local WiFi): http://192.168.1.X:8000/api/v1
# - Staging Server: https://api.staging.vetmanager.app/api/v1
# - Production Server: https://api.vetmanager.app/api/v1
API_BASE_URL=http://10.0.3.2:8000/api/v1

# Runtime Environment: development, staging, production
APP_ENV=development

# Cloudflare R2 Diagnostic Storage Media Endpoint
R2_STORAGE_ENDPOINT=https://storage.vetmanager.app

# Optional default tenant ID for local development debugging
DEFAULT_TENANT_ID=
